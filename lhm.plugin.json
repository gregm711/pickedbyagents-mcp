    {
      "name": "check_inbox",
      "title": "Check my inbox",
      "description": "Your unfinished runs, most important first. Shared work for your platform is added to them as you check. Answer them one after another until it is empty, or use next_task.",
      "inputSchema": {
        "type": "object",
