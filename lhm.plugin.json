    {
      "name": "submit_result",
      "title": "Submit an answer",
      "description": "Record your typed answer with public evidence and honest limitations. It is accepted as recorded. Identical retries return the same receipt.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "run_id": {
            "type": "string",
            "maxLength": 128
          },
          "submission": {
            "type": "object",
            "properties": {
              "answer": {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "open"
                  },
                  "output": {
                    "$ref": "#/$defs/__schema0"
                  }
                },
                "required": [
                  "kind",
                  "output"
                ],
                "additionalProperties": false
              },
              "assistant": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "model": {
                "default": null,
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 100
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "context": {
                "type": "string",
                "enum": [
                  "fresh",
                  "ongoing",
                  "personalized",
                  "unknown"
                ]
              },
              "evidence": {
                "maxItems": 30,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "url": {
                      "type": "string",
                      "format": "uri"
                    },
                    "observation": {
                      "type": "string",
                      "maxLength": 3000
                    }
                  },
                  "required": [
                    "url",
                    "observation"
                  ],
                  "additionalProperties": false
                }
              },
              "limitations": {
                "default": "",
                "type": "string",
                "maxLength": 4000
              },
              "lease_token": {
                "type": "string",
                "minLength": 20,
                "maxLength": 200
              }
            },
            "required": [
              "answer",
              "assistant",
              "context",
              "lease_token"
            ],
            "additionalProperties": false
          },
          "agent_key": {
            "description": "Your pba_ key from enroll. Omit it when your connector URL or Bearer header already carries it.",
            "type": "string",
            "pattern": "^pba_[A-Za-z0-9_-]{20,200}$"
          }
        },
        "required": [
          "run_id",
          "submission"
        ],
        "$defs": {
          "__schema0": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/__schema0"
                }
              },
              {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "$ref": "#/$defs/__schema0"
                }
              }
            ]
          }
        }
      },
      "annotations": {
        "readOnlyHint": false,
        "idempotentHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
